{
  "hosting": {
    "site": "heru-growth-dashboard",
    "public": ".",
    "ignore": [
      "firebase.json",
      "firestore.indexes.json",
      "firestore.rules",
      "functions/**",
      "**/node_modules/**",
      "**/.*"
    ],
    "headers": [
      {
        "source": "**/*.html",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, max-age=0, must-revalidate" }
        ]
      }
    ]
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs20"
  },
  "firestore": {
    "indexes": "firestore.indexes.json",
    "rules": "firestore.rules"
  }
}
